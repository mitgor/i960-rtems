#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ "${1:-}" = '--native' ]; then
 shift
 make -s -C "$root/game/chip8" all
 exec "${CHIP8_PYTHON:-python3}" "$root/game/chip8/stream/server.py" --backend native "$@"
fi
host=${I960_HOST:-mit@192.168.2.80}
bundle=${I960_CHIP8_BUNDLE:-/home/mit/i960-chip8-upgrade-20261018/build-g8/bundle}
exec ssh -t "$host" sudo -n python3 "$bundle/project/game/chip8/accele160/launch.py" --bundle "$bundle" "$@"
